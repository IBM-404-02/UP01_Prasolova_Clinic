<Page x:Class="UP01_Prasolova_Clinic.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Prasolova_Clinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" Style="{DynamicResource TitleText}"/>

            <Label Content="Логин"/>
            <Grid>
                <TextBox x:Name="TextBoxLogin" MaxLength="50"
                     ToolTip="Введите логин, указанный при регистрации"
                     TextChanged="TextBoxLogin_TextChanged"/>
                <TextBlock x:Name="txtHintLogin" Text="Введите логин"
                       Style="{DynamicResource HintText}"/>
            </Grid>

            <Label Content="Пароль"/>
            <Grid>
                <PasswordBox x:Name="PasswordBox" MaxLength="50"
                         ToolTip="Введите пароль"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock x:Name="txtHintPass" Text="Введите пароль"
                       Style="{DynamicResource HintText}"/>
            </Grid>

            <Button x:Name="ButtonEnter" Content="Войти"
                ToolTip="Войти в систему" Click="ButtonEnter_Click"/>
            <Button x:Name="ButtonReg" Content="Регистрация"
                ToolTip="Создать новую учётную запись" Click="ButtonReg_Click"/>
            <Button x:Name="ButtonChangePassword" Content="Смена пароля"
                ToolTip="Изменить пароль" Click="ButtonChangePassword_Click"/>
        </StackPanel>
    </Grid>
</Page>
