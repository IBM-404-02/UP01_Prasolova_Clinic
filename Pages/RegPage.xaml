<Page x:Class="UP01_Prasolova_Clinic.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Prasolova_Clinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10">
                <TextBlock Text="Регистрация" Style="{DynamicResource TitleText}"/>

                <Label Content="Логин"/>
                <Grid>
                    <TextBox x:Name="TextBoxLogin" MaxLength="50"
                         ToolTip="Латинские буквы, цифры и _ (от 3 до 50 символов)"
                         TextChanged="TextBox_TextChanged"
                         PreviewTextInput="TextBoxLogin_PreviewTextInput"/>
                    <TextBlock Text="Придумайте логин" Style="{DynamicResource HintText}"/>
                </Grid>

                <Label Content="ФИО"/>
                <Grid>
                    <TextBox x:Name="TextBoxFIO" MaxLength="150"
                         ToolTip="Фамилия Имя Отчество на русском языке"
                         TextChanged="TextBox_TextChanged"
                         PreviewTextInput="TextBoxFIO_PreviewTextInput"/>
                    <TextBlock Text="Иванов Иван Иванович" Style="{DynamicResource HintText}"/>
                </Grid>

                <Label Content="Пароль"/>
                <Grid>
                    <PasswordBox x:Name="PasswordBoxNew" MaxLength="50"
                             ToolTip="Не менее 6 символов: английские буквы и хотя бы одна цифра"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock Text="Придумайте пароль" Style="{DynamicResource HintText}"/>
                </Grid>

                <Label Content="Подтверждение пароля"/>
                <Grid>
                    <PasswordBox x:Name="PasswordBoxConfirm" MaxLength="50"
                             ToolTip="Повторите пароль"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock Text="Повторите пароль" Style="{DynamicResource HintText}"/>
                </Grid>

                <Label Content="Роль"/>
                <ComboBox x:Name="ComboBoxRole" SelectedIndex="0"
                      ToolTip="Выберите роль пользователя">
                    <ComboBoxItem Content="Пользователь" Tag="User"/>
                    <ComboBoxItem Content="Администратор" Tag="Admin"/>
                </ComboBox>

                <Button x:Name="ButtonRegister" Content="Создать аккаунт"
                    ToolTip="Зарегистрировать нового пользователя"
                    Click="ButtonRegister_Click" Margin="5,15,5,5"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
